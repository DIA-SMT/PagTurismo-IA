   "title": {
    "rendered": "Pintura para niños"
   },
   "content": {
    "rendered": "\n<p class=\"wp-block-paragraph\">Un espacio creativo pensado para que los niños y niñas se acerquen a la pintura desde el disfrute. Mediante la experimentación con colores, formas y texturas, se promueve la expresión artística y la curiosidad.</p>\n\n\n\n<p class=\"wp-block-paragraph\">Prof. Gabriela Ledesma</p>\n\n\n\n<p class=\"wp-block-paragraph\">Libre y gratuito. &nbsp;</p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n"
